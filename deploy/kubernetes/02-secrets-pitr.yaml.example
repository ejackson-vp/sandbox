# Example of the Secret pgBackRest reads (ADR 0015). Do not commit a filled-in
# copy.
#
# Every key is a pgBackRest option name with `-` replaced by `_` and the
# `PGBACKREST_` prefix, because the pods take the whole Secret with `envFrom`.
# That means an operator can add an option the design did not anticipate (path
# style addressing, a non-443 port, a CA bundle) by adding a key here, without
# touching a manifest:
#
#   PGBACKREST_REPO1_S3_URI_STYLE=path
#   PGBACKREST_STORAGE_PORT=9000
#   PGBACKREST_STORAGE_CA_FILE=/etc/pgbackrest/ca.pem
#
# Options that are not secret belong in
# deploy/kubernetes/pitr/configmap.yaml, where they are reviewable. Environment
# wins over the file, so a key here silently overrides the ConfigMap: keep this
# Secret to credentials and the location of the bucket.
#
# The cipher pass is recovery material, not a deployment detail. Without it the
# repository cannot be read, so store a copy somewhere that survives losing the
# cluster and the Secret store (a password manager record, a sealed envelope),
# and never in the bucket it encrypts.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-pitr
  namespace: sandbox-system
type: Opaque
stringData:
  # Where the backups go. S3-compatible is enough: this is the vendor's
  # endpoint, not a vendor SDK.
  PGBACKREST_REPO1_S3_BUCKET: <bucket-name>
  PGBACKREST_REPO1_S3_ENDPOINT: <object-store-endpoint>
  PGBACKREST_REPO1_S3_REGION: <region>
  PGBACKREST_REPO1_S3_KEY: <access-key-id>
  PGBACKREST_REPO1_S3_KEY_SECRET: <access-key-secret>
  # openssl-style passphrase for repo1-cipher-type=aes-256-cbc.
  PGBACKREST_REPO1_CIPHER_PASS: <generated-passphrase>
