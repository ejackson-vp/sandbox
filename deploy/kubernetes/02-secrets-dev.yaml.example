# Example of the Secret the API, controller, relay and egress proxy need.
#
# Do not commit a filled-in copy. Locally, `scripts/dev-secrets.sh` writes
# deploy/kubernetes/02-secrets-dev.yaml (git-ignored). A deployed environment
# injects this Secret from its own secret store instead.
#
# Every value except the attestation key/id is a real credential:
#   admin-token        controller and API admin API
#   relay-admin-token  relay <-> controller
#   wake-token         low-privilege nudge
#   proxy-token-secret egress proxy <-> controller
#   capability-secret  derives session capabilities (must differ from admin-token)
#
# `postgres-credentials` is separate on purpose: the database server reads
# `password`, and the controller reads `database-url`, which must carry the same
# password. Keep them generated together (scripts/dev-secrets.sh does).
apiVersion: v1
kind: Secret
metadata:
  name: x402-secrets
  namespace: sandbox-system
type: Opaque
stringData:
  admin-token: <generated>
  relay-admin-token: <generated>
  wake-token: <generated>
  proxy-token-secret: <generated>
  capability-secret: <generated>
  # Dev-only simulated attestation key. Published by design; remove it in
  # production and replace attestation with hardware evidence.
  dev-attestation-key: <base64-32-byte-seed>
  dev-attestation-key-id: <key-id>
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: sandbox-system
type: Opaque
stringData:
  username: sandbox
  password: <generated>
  database: sandbox
  # Same password as above, as a URL. `sslmode=disable` is correct in-cluster and
  # on kind; a deployment that terminates TLS at the database overrides it.
  database-url: postgres://sandbox:<generated>@postgres.sandbox-system.svc.cluster.local:5432/sandbox?sslmode=disable
