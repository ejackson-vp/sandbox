# Single control-plane image for api / controller / relay / egress-proxy /
# mock facilitator. Different Deployments run different entrypoints so that
# NetworkPolicy can separate them.
#
# The runtime stage carries production dependencies only, and only the built
# output of the packages it actually runs. The dev toolchain (TypeScript,
# vitest, tsx, esbuild/rolldown) and the package sources never reach the image.

FROM node:26-alpine@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216 AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/package.json
COPY sdk/package.json sdk/package.json
COPY api/package.json api/package.json
COPY controller/package.json controller/package.json
COPY cli/package.json cli/package.json
RUN npm ci --omit=dev --no-audit --no-fund

FROM node:26-alpine@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216 AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY shared/package.json shared/package.json
COPY sdk/package.json sdk/package.json
COPY api/package.json api/package.json
COPY controller/package.json controller/package.json
COPY cli/package.json cli/package.json
RUN npm ci --no-audit --no-fund
COPY shared shared
COPY sdk sdk
COPY api api
COPY controller controller
COPY cli cli
RUN npm run build

FROM node:26-alpine@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216
ENV NODE_ENV=production \
    HOME=/tmp \
    SERVICE_NAME=control-plane
WORKDIR /app
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/shared/package.json ./shared/package.json
COPY --from=build /app/shared/dist ./shared/dist
COPY --from=build /app/api/package.json ./api/package.json
COPY --from=build /app/api/dist ./api/dist
COPY --from=build /app/controller/package.json ./controller/package.json
COPY --from=build /app/controller/dist ./controller/dist

# The runtime executes node only, never a package manager.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

USER 1000:1000
EXPOSE 3000 3001 3002 3128 8443
CMD ["node", "api/dist/main.js"]
