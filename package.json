{
  "name": "sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pay-per-session sandbox service using x402 micropayments",
  "workspaces": [
    "shared",
    "sdk",
    "api",
    "controller",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @x402s/shared && npm run build -w @x402s/sdk && npm run build -w @x402s/api && npm run build -w @x402s/controller && npm run build -w @x402s/cli",
    "typecheck": "npm run build -w @x402s/shared && npm run build -w @x402s/sdk && tsc -p api/tsconfig.json --noEmit && tsc -p controller/tsconfig.json --noEmit && tsc -p cli/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run test:unit && npm run test:property",
    "test:unit": "vitest run tests/unit --fileParallelism",
    "test:store-contract": "vitest run tests/unit/store-contract-postgres.test.ts",
    "test:store-contract-restored": "vitest run tests/restore",
    "test:restore-drill": "vitest run tests/integration/restore-drill.test.ts",
    "test:integration": "vitest run tests/integration --exclude \"**/restore-drill.test.ts\"",
    "test:integration:coverage": "X402_COVERAGE_PARTIAL=1 vitest run tests/integration --exclude \"**/restore-drill.test.ts\" --coverage --coverage.reportsDirectory=coverage-integration",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:fuzz": "vitest run tests/fuzz",
    "test:fuzz:coverage": "X402_COVERAGE_PARTIAL=1 vitest run tests/fuzz --coverage --coverage.reportsDirectory=coverage-fuzz",
    "clean": "rm -rf shared/dist sdk/dist api/dist controller/dist cli/dist",
    "test:property": "vitest run tests/property --fileParallelism",
    "test:portable": "vitest run tests/transfers tests/workloads tests/compatibility --fileParallelism",
    "test:coverage": "vitest run tests/unit tests/property --coverage --fileParallelism",
    "mutation": "stryker run",
    "lint:structure": "node scripts/check-structure.mjs && node scripts/check-singletons.mjs",
    "coupling": "node scripts/coupling.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
